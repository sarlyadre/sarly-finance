# Copy this file to ".env.local" and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Statement importer / scheduled finance sync (scripts/ingest-statement.mts).
# Local machine only — these never go in git or Vercel.
# SUPABASE_SERVICE_ROLE_KEY=   (Supabase → Settings → API Keys → Secret keys)
# STATEMENT_PDF_PASSWORD=      (your Maybank e-statement PDF password; Maybank's
#                               default is date of birth as ddMmmYYYY, e.g. 01Jan1980)
